//-  Endeavor Project | Full-Width, Text left, Right-Aligned Square Image
    Requires: <data.supertext> <data.text> <data.img>
    Description: Full-Width, Responsive Img + Text Element

mixin endeavorTextLeftImageFS(data)
    - var text = data.text
    - var superText = data.superText
    - var image = data.image
    - var sources = `${data.image.src_standard} 1x, ${data.image.src_retina} 2x`
    - var bgColor = data.bgColor ? data.bgColor : "transparent"
    - var textColor = data.textColor ? data.textColor : "#232323" // $BLACK
    - var sizeClass = data.sizeClass

    .endeavor-element.endeavor-item.endeavor-horizontal-10vw.endeavor-flex-row-nowrap.endeavor-flex-center-main.endeavor-flex-between.fsw(style=`background-color: ${bgColor}`)
        img.lazyload.endeavor-second.blur-up(src=image.src_low)&attributes({'data-sizes': "auto"}, {'data-srcset': sources}, {'class':sizeClass})
        .endeavor-block
            h3.endeavor-text-left(style=`color: ${textColor}`)=data.superText
            p.endeavor-pulltext.endeavor-text-left(style=`color: ${textColor}`)=data.text


