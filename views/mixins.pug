//-  Progress Bar Component
    Requires: <data> 
        + data.endeavor_name <string>
        + data.endeavor_type <string>
        + data.sections <array>
        + data.sections[·].name -> Map to target
        + data.class -> Optional class modifier

//- How to populate this with data? -> Access wrt project open
mixin progressBar()
    - var sections = [1,2,3,4,5]
    //- - var sections = data.sections ? data.sections : ""
    //- - var name = data.name ? data.name : "Endeavor"
    //- - var type = data.type ? data.type : "Project"
    //- - var _class = data.class ? data.class : "Project"
    #progress-container.endeavor-element.endeavor-flex.endeavor-flex-nowrap.endeavor-flex-between.endeavor-width-75-prcnt.endeavor-center.endeavor-flex-center.endeavor-height-100-prcnt(class=_class)
        .progress.endeavor-border-medium-1.medium-border-1.endeavor-left-0.endeavor-width-35-prcnt.endeavor-pos-abs.endeavor-top-50-prcnt.endeavor-push-1.header-hover-grow
        .progress_bg.endeavor-border-medium-1.medium-border-1.endeavor-border-dashed.endeavor-left-0.fsw.endeavor-pos-abs.endeavor-top-50-prcnt.header-hover-grow
        each section, i in sections
            .section-pagination.endeavor-flex-column.endeavor-flex-justify-center.endeavor-push-2
                h5.endeavor-text-center.medium-text-1
                    | Hello 
                .endeavor-square-5px.endeavor-circle.endeavor-flex-self-center.medium-bg-1


//-  Case-Study Preview
    Requires: <data> <index> 
        + route <scr/string>
        + name-preview <string>
        + project-type <string>
        + project-name <string> 
        + project-description <string>
        + project-image-preview <src>

mixin caseStudyPreview(data, index)
    .endeavor-element.case-study.case-study-window.item.case-study-item.endeavor-height-1000px-responsive.endeavor-height-60vh.endeavor-height-600px-mobile.case-study-preview&attributes( {'data-inproject': false}, {'data-projectIndex': index}, {'data-project': data.route},  {'id': data.preview} )
        .case-study-overview.endeavor-overview.endeavor-overview-preview
            .description
                .description-wrapper
                    h3=data.project_type
                    h2.project-intro=data.name
                    button#case-study-more.endeavor-button.flat
                        h3.endeavor-center.endeavor-text-center.endeavor-transition-500 Read more
            .hero-box
                .hero(style=`background-image: url(${data.image_hero})`)


//-  Case-Study Preview Alt
    Requires: <data> <index> 
        + route <scr/string>
        + name-preview <string>
        + project-type <string>
        + project-name <string>
        + project-description <string>
        + project-image-preview <src>

mixin caseStudyPreviewAlt(data, index)
    .endeavor-element.case-study.case-study-window.item.case-study-item.endeavor-height-1000px-responsive.endeavor-height-600px-mobile&attributes( {'data-inproject': false}, {'data-projectIndex': index}, {'data-project': data.route},  {'id': data.preview} )
